# Database Configuration
DB_URL=postgres://username:password@localhost:5432/unipool_db?sslmode=disable

# Firebase Configuration
SERVICE_CREDS={"type":"service_account","project_id":"your-project-id","private_key_id":"..."}

# Schema migrations are managed by goose under `migrations/`. The
# service binary does NOT touch the schema on boot. Apply pending
# migrations with:
#   ./unipool-backend migrate
# Inspect pending state with:
#   ./unipool-backend migrate-status
# SHOULD_MIGRATE is retained only to keep older deployment scripts
# from failing; the value is otherwise ignored.
SHOULD_MIGRATE=FALSE

# Server Configuration (optional - defaults to 3000)
PORT=3000

# AWS SES (verification emails, ap-south-1)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
